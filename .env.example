# ── Turnkey (use a NON-ROOT user's API key, see README) ──────────────────────
TURNKEY_ORGANIZATION_ID=your-parent-organization-id
TURNKEY_API_PUBLIC_KEY=02...
TURNKEY_API_PRIVATE_KEY=...
# TURNKEY_BASE_URL=https://api.turnkey.com

# ── MCP server ───────────────────────────────────────────────────────────────
# Access token: typed once on the OAuth sign-in page, or sent as a bearer token.
# Rotating it signs out every client. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Public base URL of this server, used in the OAuth metadata (http only for localhost)
PUBLIC_URL=https://turnkey-mcp.example.com
PORT=3000
# Reverse proxies in front of the app (for client IPs); 0 if clients connect directly
TRUST_PROXY=1

# ── Scanner (optional) ───────────────────────────────────────────────────────
# Days of signing history kept in memory (drives "signatures per month")
SCAN_WINDOW_DAYS=180
# How often the background scan refreshes the snapshot
SCAN_INTERVAL_MINUTES=360
# Turnkey requests in flight. The rate limit is shared with every client of the organization.
SCAN_CONCURRENCY=1
# Cap on request starts per second
SCAN_MAX_REQUESTS_PER_SECOND=4
MAX_SUB_ORGS=20000

# ── Network classification (optional) ────────────────────────────────────────
# Extra EVM chain IDs to treat as testnet / mainnet (comma-separated)
TESTNET_CHAIN_IDS=
MAINNET_CHAIN_IDS=
